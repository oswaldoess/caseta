      "name": "3. Flujo principal: de la visita a la salida",
      "item": [
        {
          "name": "E17 El residente registra una visita (genera el código)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/visitas",
              "host": [
                "{{baseUrl}}"
