                {
                  "key": "token",
                  "value": "{{tokenResidente}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"unica\",\n  \"nombreVisitante\": \"Laura Méndez Ríos\",\n  \"placas\": \"umr-482-b\",\n  \"numeroPersonas\": 3,\n  \"fecha\": \"{{hoy}}\",\n  \"horaInicio\": \"{{horaInicio}}\",\n  \"horaFin\": \"{{horaFin}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Devuelve un código de 8 caracteres\", () => { const v = pm.response.json(); pm.expect(v.codigo).to.match(/^[A-HJ-NP-Z2-9]{8}$/); pm.collectionVariables.set(\"codigo\", v.codigo); pm.collectionVariables.set(\"visitaId\", v.id); });"
                ]
