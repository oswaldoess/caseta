{
  "info": {
    "name": "Caseta - Demo final (Entrega 8)",
    "description": "Demostración mínima de la Entrega 8, en orden: inicio de sesión, CRUD, flujo principal, reglas de negocio, permisos, manejo de errores y persistencia. Correr con los servicios levantados (npm run dev) y la base recién creada (npm run db:crear).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Fecha y horario de hoy en la Ciudad de México (UTC-6), para que la visita sea válida al momento de la demo.",
          "const d = new Date(Date.now() - 6 * 60 * 60 * 1000);",
          "const dos = (n) => String(n).padStart(2, \"0\");",
          "const hhmm = (m) => { m = Math.max(0, Math.min(23 * 60 + 59, m)); return dos(Math.floor(m / 60)) + \":\" + dos(m % 60); };",
          "const minutos = d.getUTCHours() * 60 + d.getUTCMinutes();",
          "pm.collectionVariables.set(\"hoy\", d.toISOString().slice(0, 10));",
          "pm.collectionVariables.set(\"horaInicio\", hhmm(minutos - 60));",
          "pm.collectionVariables.set(\"horaFin\", hhmm(minutos + 120));",
          "if (!pm.collectionVariables.get(\"sufijo\")) pm.collectionVariables.set(\"sufijo\", String(Date.now()).slice(-6));"
        ]
      }
    }
  ],
