# S1. Identidad
PORT=3001
NOMBRE_SERVICIO=identidad

# Base de datos: cada servicio usa su propio usuario de MySQL (database/04_usuarios_servicios.sql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=caseta
DB_USER=caseta_identidad
DB_PASSWORD=cambiar_esta_contrasena

# Seguridad (valores de ejemplo; nunca subir los reales)
JWT_SECRET=cambiar_este_secreto
CLAVE_SERVICIO=cambiar_esta_clave

# Costo de bcrypt para las contraseñas (RNF01: al menos 10)
BCRYPT_COSTO=10
